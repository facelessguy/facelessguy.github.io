---
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../796129793.png';
import { profile } from '../config/profile';
---
<BaseLayout title={`${profile.name || 'Практика'} — обучение, продукты, разработка`}>
  <main id="main">
    <section class="hero wrap" id="top">
      <div class="hero-kicker"><span class="eyebrow">Портфолио / 2026</span><span class="edition">От задачи — к работающему продукту</span></div>

      <div class="hero-grid">
        <div class="profile-text">
          <h1 class="hero-statement"> Здравствуйте, я — Ник Асотов, </h1>
          <h1 class="hero-statement-red"> Методист-разработчик электронных курсов.</h1>
          <h2 class="hero-highlight"><span>Создаю обучение, которое помогает разобраться в сложном и применить знания на практике.</span></h2>
          <div class="hero-actions">
            <a href="/projects/" class="button">Смотреть демо <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <figure class="profile">
          <img src={portrait.src} width={portrait.width} height={portrait.height} alt="Портрет автора портфолио" fetchpriority="high" />
          <figcaption><span>Обучение · Продукты · Разработка</span><span>01 / 04</span></figcaption>
        </figure>
      </div>
    </section>
  </main>
</BaseLayout>
