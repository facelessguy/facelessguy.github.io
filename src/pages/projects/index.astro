---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicProjects, getAllDemos } from '../../lib/projects';

const projects = await getPublicProjects();
const demos = await getAllDemos();
const projectBySlug = new Map(projects.map((project) => [project.slug, project]));
const catalog = demos.flatMap((demo) => {
  const project = projectBySlug.get(demo.data.project);
  return project ? [{ ...demo, project }] : [];
});
---
<BaseLayout title="Каталог демо — Практика" description="Демонстрационные курсы и проекты портфолио.">
  <main id="main" class="wrap page-main">
    <div class="page-intro-block">
      <p class="eyebrow">В действии / Демо</p>
      <h1 class="page-title">Каталог демо</h1>
    </div>
    {catalog.length ? (
      <div class="project-grid">
        {catalog.map(({ id, data, project }) => {
          const isPublished = project.status === 'published' && data.status === 'published';
          return <article class="project-card">
            {project.cover && <div class="project-cover"><img src={project.cover.src} alt={project.cover.alt} width={project.cover.width} height={project.cover.height} loading="lazy" decoding="async" /></div>}
            <div class="project-card-body">
              <div class="project-meta"><span>{project.year}</span><span>{isPublished ? 'Доступно' : 'В подготовке'}</span></div>
              <h3>{isPublished ? <a href={`/demos/${id}/`}>{data.title} <span aria-hidden="true">↗</span></a> : data.title}</h3>
              <p>{data.summary}</p>
              <div class="tags">{project.disciplines.map((tag) => <span>{tag}</span>)}</div>
              {isPublished && <div class="card-actions">
                {data.format === 'SCORM 1.2'
                  ? <a class="button" href={`/lms/${id}/`}>Запустить курс ↗</a>
                  : data.format === 'Video'
                    ? <a class="button" href={`/demos/${id}/`}>Смотреть видео ↗</a>
                    : <a class="button" href={data.launch}>Открыть демо ↗</a>}
                <a href={`/projects/${project.slug}/`}>О проекте ↗</a>
              </div>}
            </div>
          </article>;
        })}
      </div>
    ) : (
      <div class="empty-work"><span class="large-asterisk" aria-hidden="true">↗</span><div><h2 class="empty-title">Демо готовятся к публикации</h2><p>Опубликованные материалы появятся здесь.</p></div></div>
    )}
  </main>
</BaseLayout>
