---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedDemos, getPublicProjects } from '../../lib/projects';
import VideoPlayer from '../../components/VideoPlayer.astro';
export async function getStaticPaths() { return (await getPublishedDemos()).map(demo => ({ params: { slug: demo.id }, props: { demo } })); }
const { demo } = Astro.props;
const { data } = demo;
const { Content } = await render(demo);
const project = (await getPublicProjects()).find(({ slug }) => slug === data.project);
---
<BaseLayout title={`${data.title} — демо`} description={data.summary} image={null}>
  <main id="main" class="wrap page-main"><a class="back-link" href="/projects/" data-reveal>← Все демо</a><div class="page-intro-block" data-reveal><p class="eyebrow">{data.format}{data.duration && ` / ${data.duration}`}</p><h1 class="page-title">{data.title}</h1><p class="page-intro">{data.summary}</p></div>
    {data.format === 'Video' ? <VideoPlayer src={data.launch} poster={project?.cover?.src} title={data.title} /> : <div class="demo-launch" data-reveal><a class="button" href={data.format === 'SCORM 1.2' ? `/lms/${demo.id}/` : data.launch}>{data.format === 'SCORM 1.2' ? 'Запустить в мини‑LMS ↗' : 'Запустить демо ↗'}{data.format !== 'SCORM 1.2' && <span class="sr-only"> в новой вкладке</span>}</a><a class="text-link" href={`/projects/${data.project}/`}>Читать кейс ↗</a></div>}
    <p class="demo-requirements" data-reveal>{data.requirements}</p><article class="prose demo-prose" data-reveal><Content /></article>
  </main>
</BaseLayout>
