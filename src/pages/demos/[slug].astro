---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedDemos } from '../../lib/projects';
export async function getStaticPaths() { return (await getPublishedDemos()).map(demo => ({ params: { slug: demo.id }, props: { demo } })); }
const { demo } = Astro.props;
const { data } = demo;
const { Content } = await render(demo);
---
<BaseLayout title={`${data.title} — демо`} description={data.summary} image={null}>
  <main id="main" class="wrap page-main"><a class="back-link" href="/demos/" data-reveal>← Все демо</a><div class="page-intro-block" data-reveal><p class="eyebrow">{data.format}{data.duration && ` / ${data.duration}`}</p><h1 class="page-title">{data.title}</h1><p class="page-intro">{data.summary}</p></div>
    <div class="demo-launch" data-reveal><a class="button" href={data.launch} target="_blank" rel="noopener noreferrer">Запустить демо ↗<span class="sr-only"> в новой вкладке</span></a><a class="text-link" href={`/projects/${data.project}/`}>Читать кейс ↗</a></div><p class="demo-requirements" data-reveal>{data.requirements}</p><article class="prose demo-prose" data-reveal><Content /></article>
  </main>
</BaseLayout>
