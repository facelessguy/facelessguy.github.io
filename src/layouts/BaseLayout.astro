---
import '../styles/global.css';
import { profile, positioning } from '../config/profile';
import { getPublicProjects } from '../lib/projects';
const hasLab = (await getPublicProjects()).some(p => p.kind === 'experiment' && p.status === 'published');
interface Props { title: string; description?: string; noindex?: boolean; image?: string | null; imageAlt?: string; }
const { title, description = positioning, noindex = false, image = '/og.png', imageAlt = 'От задачи к работающему продукту. Обучение, продукты, разработка.' } = Astro.props;
const pageTitle = title.replace(/ — Практика$/, ` — ${profile.name || 'Практика'}`);
const socialImage = image && Astro.site ? new URL(image, Astro.site) : undefined;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="robots" content={noindex || !Astro.site ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <><meta property="og:image" content={socialImage} /><meta property="og:image:alt" content={imageAlt} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content={imageAlt} /></>}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти к содержимому</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="На главную"><span class="brand-mark" aria-hidden="true">↗</span><span>{profile.name || 'Практика'}<small>Обучение · Продукты · Разработка</small></span></a>
      <nav aria-label="Основная навигация"><a href="/projects/">Работы</a><a href="/demos/">Демо</a>{hasLab && <a href="/lab/">Лаборатория</a>}<a href="/#about">Обо мне</a></nav>
      <a class="header-contact" href="/#contact">Контакты <span aria-hidden="true">↗</span></a>
    </header>
    <slot />
    <footer class="wrap site-footer"><span>© {new Date().getFullYear()} {profile.name || 'Практика'}</span><span>От задачи к работающему продукту</span><a href="#main">Наверх ↑</a></footer>
  </body>
  <script>
    import '../scripts/reveal';
  </script>
</html>
